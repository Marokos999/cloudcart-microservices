{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/cloudcart",
    "Audience": "cloudcart-client"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://cloudcart.local", "http://cloudcart.local:8888" ]
  },
  "ReverseProxy": {
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cloudcart-catalog:80"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cloudcart-basket:80"
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cloudcart-ordering:80"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cloudcart-inventory:80"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cloudcart-payment:80"
          }
        }
      },
      "discount-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cloudcart-discount-grpc:80"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cloudcart-notification:80"
          }
        }
      }
    }
  }
}
