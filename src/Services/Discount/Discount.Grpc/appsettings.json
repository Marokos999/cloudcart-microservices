{
  "ConnectionStrings": {
    "Database": "Data Source=discount.db"
  },
  "Kestrel": {
    "Endpoints": {
      "Grpc": {
        "Url": "http://*:8080",
        "Protocols": "Http2"
      },
      "Rest": {
        "Url": "http://*:8081",
        "Protocols": "Http1AndHttp2"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}